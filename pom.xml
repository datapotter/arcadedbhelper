<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.datapotter</groupId>
    <artifactId>datapotter-arcadedbhelper-parent</artifactId>
    <version>2.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>DataPotter ArcadeDBHelper (parent)</name>
    <description>The ArcadeDB backend: one implementation over datahelper, versioned on its own line.</description>
    <url>https://github.com/datapotter/arcadedbhelper</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>datapotter</id>
            <name>Ivan Velikanov</name>
            <email>ivan.velikanov.dev@gmail.com</email>
            <url>https://github.com/datapotter</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/datapotter/arcadedbhelper.git</connection>
        <developerConnection>scm:git:ssh://github.com:datapotter/arcadedbhelper.git</developerConnection>
        <url>https://github.com/datapotter/arcadedbhelper</url>
    </scm>

    <!--
      A SEPARATE REACTOR FROM datahelper, ON PURPOSE. This is one backend over that core, not a part
      of it — the dependency runs one way and has never run the other. The release histories agree:
      this reached 1.8 while datahelper-annotations reached 1.2, and 1.2/1.3/1.4 here each recorded
      "no annotation-processor change", meaning they shipped while the core stood still. Folding the
      two together would have dragged every core module to a new version for an ArcadeDB query
      feature, and would have made a future second backend just another entry in a growing list.

      The two lines happen to start aligned at 2.0 because this release is the one that consumes
      datahelper 2.0. They are free to diverge from here, and should.

      datahelper.version is ONE property rather than the five places these coordinates used to be
      written, so moving to the next core release is a one-line change. Point it at the SNAPSHOT
      while developing a cross-boundary change, and at the released version once the core is
      published.
    -->

    <properties>
        <datahelper.version>2.0</datahelper.version>
    </properties>

    <modules>
        <module>core</module>
        <module>processor</module>
    </modules>

    <!--
      The parent is itself a published artifact: every module names it as <parent>, so a consumer
      that cannot resolve this pom cannot resolve any module. It therefore needs the same signing
      and publishing wiring the modules have. Without it the deploy phase falls through to
      maven-deploy-plugin, which has no distributionManagement and fails the reactor before a
      single module is uploaded.

      RELEASE WITH MAVEN 3, NOT MAVEN 4:

          C:\user\Apps\cmdtools\maven\apache-maven\bin\mvn.cmd clean deploy -Dorg.name=datapotter

      central-publishing-maven-plugin 0.9.0 is a Maven 3 plugin. Under Maven 4 the extensions=true
      lifecycle binding below does not take effect: gpg:sign and install run, the reactor prints
      BUILD SUCCESS, and NOTHING IS EVER UPLOADED. There is no error to notice. Verify a release by
      fetching the artifact from repo1.maven.org, never by trusting the build result. Propagation to
      repo1 lags the portal by roughly ten to thirty minutes, so a 404 straight after a publish is
      normal; the portal saying "was successfully published" is the authoritative signal.

      datahelper.version must name a RELEASED core before this can be published at all: Central
      rejects a release that depends on a snapshot.
    -->
    <profiles>
        <profile>
            <id>release</id>
            <activation>
                <property><name>org.name</name></property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <keyname>${org.gpg.keyname}</keyname>
                            <passphrase>${org.gpg.passphrase}</passphrase>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.9.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>${org.publishing.server.id}</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
